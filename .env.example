DEBUG=True
SECRET_KEY=replace-with-a-long-random-value
REGISTRATION_CODE=replace-with-a-private-registration-code
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/New_York
DATABASE_URL=sqlite:///db.sqlite3
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# The console backend prints password-reset links in the web-server terminal.
# Use django.core.mail.backends.smtp.EmailBackend and fill in SMTP settings in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=NetOps <noreply@example.com>
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
